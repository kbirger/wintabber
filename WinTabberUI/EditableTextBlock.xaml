<UserControl x:Class="WinTabberUI.EditableTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Name="root"
             Focusable="False"
             xmlns:local="clr-namespace:WinTabberUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Button style (simple, small) -->
        <local:BoolToBrushConverter x:Key="BorderBrushConverter" local:BoolToBrushConverter.EditBrush="#ff666666" local:BoolToBrushConverter.ViewBrush="Transparent"/>


        <Style x:Key="InlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="6, 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Trigger.Setters>
                        <Setter Property="Foreground" Value="#dd333333"/>
                    </Trigger.Setters>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Background" Value="#dd666666"/>
                    </Trigger.Setters>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border x:Name="BorderContainer"
            CornerRadius="4"
            Background="{Binding IsMouseOver, ElementName=root, Converter={StaticResource BorderBrushConverter}}"
            BorderThickness="{Binding IsEditing, ElementName=root, Converter={StaticResource BoolToThicknessConverter}}"
            BorderBrush="Gray"
            >
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TextBox"
                     Text="{Binding CurrentText, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Foreground="White"
                     Background="Transparent"
                     IsReadOnly="{Binding IsEditing, ElementName=root, Converter={StaticResource InverseBoolConverter}}"
                     Cursor="Arrow"
                     VerticalAlignment="Center"
                     Padding="2"
                     GotFocus="TextBox_GotFocus"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button 
                    x:Name="AcceptButton" 
                    Style="{StaticResource InlineButton}" 
                    Click="Accept_Click" 
                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:EditableTextBlock}, Path=IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                    >
                    <fa:IconBlock Icon="Check"/>
                </Button>
                <Button 
                    x:Name="CanceButton" 
                    Style="{StaticResource InlineButton}" 
                    Click="Cancel_Click" 
                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:EditableTextBlock}, Path=IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <fa:IconBlock Icon="Ban"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <UserControl.Style>
        <Style TargetType="local:EditableTextBlock">

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <!--<Setter Property="Background" Value="#ff666666"/>-->
                    </Trigger.Setters>
                </Trigger>
                <!--<DataTrigger Binding="{Binding IsEditing, ElementName=root}" Value="True">
                    <Setter TargetName="AcceptButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CancelButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>-->
                <!-- Show buttons and borders only in edit mode -->
                <!--<DataTrigger Binding="{Binding IsEditing, ElementName=root}" Value="True">-->
                <!--<Setter TargetName="AcceptButton" Property="Visibility" Value="Visible"/>-->
                <!--<Setter TargetName="CancelButton" Property="Visibility" Value="Visible"/>-->
                <!--</DataTrigger>-->
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
