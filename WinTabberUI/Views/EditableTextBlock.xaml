<rxui:ReactiveUserControl x:Class="WinTabberUI.EditableTextBlock"
                                   x:TypeArguments="vm:WindowItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
             xmlns:rxui="http://reactiveui.net"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Name="root"
             Focusable="False"
             xmlns:local="clr-namespace:WinTabberUI"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance vm:WindowItem,  IsDesignTimeCreatable=False}"
>
    <UserControl.Resources>
        <!-- Button style (simple, small) -->
        <local:BoolToBrushConverter x:Key="BorderBrushConverter" local:BoolToBrushConverter.EditBrush="#ff666666" local:BoolToBrushConverter.ViewBrush="Transparent"/>


        <Style x:Key="InlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="6, 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Trigger.Setters>
                        <Setter Property="Foreground" Value="#dd333333"/>
                    </Trigger.Setters>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Background" Value="#dd666666"/>
                    </Trigger.Setters>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border x:Name="BorderContainer"
            CornerRadius="4"
            Background="{Binding IsMouseOver, ElementName=root, Converter={StaticResource BorderBrushConverter}}"
            BorderThickness="{Binding IsEditing, Converter={StaticResource BoolToThicknessConverter}}"
            BorderBrush="Gray"
            >
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TextBox"
                     Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Foreground="White"
                     Background="Transparent"
                     IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                     Cursor="Arrow"
                     VerticalAlignment="Center"
                     Padding="2"
                     GotFocus="TextBox_GotFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveTitleCommand}" CommandParameter="{Binding Title}"/>
                    <KeyBinding Key="Escape" Command="{Binding CancelEditTitleCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button 
                    x:Name="AcceptButton" 
                    Style="{StaticResource InlineButton}" 
                    Command="{Binding SaveTitleCommand}"
                    CommandParameter="{Binding Title}"
                    Visibility="{Binding Path=IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                    >
                    <fa:IconBlock Icon="Check"/>
                </Button>
                <Button 
                    x:Name="CanceButton" 
                    Style="{StaticResource InlineButton}" 
                    Command="{Binding CancelEditTitleCommand}"
                    Visibility="{Binding Path=IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <fa:IconBlock Icon="Ban"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
