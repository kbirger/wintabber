<rxui:ReactiveUserControl x:Class="WinTabberUI.EditableTextBlock"
                                   x:TypeArguments="vm:WindowItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"                          
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
             xmlns:rxui="http://reactiveui.net"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Name="root"
             Focusable="False"
             xmlns:local="clr-namespace:WinTabberUI"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance vm:WindowItem,  IsDesignTimeCreatable=False}"
>
    <UserControl.Resources>
        <!-- Button style (simple, small) -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/EditableTextBlockResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="BorderContainer"
            CornerRadius="4"
            Background="{Binding IsMouseOver, ElementName=root, Converter={StaticResource BorderBrushConverter}}"
            BorderThickness="{Binding IsEditing, Converter={StaticResource BoolToThicknessConverter}}"
            BorderBrush="Gray"
            >
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TextBox"
                     Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Foreground="White"
                     Background="Transparent"
                     IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                     Cursor="Arrow"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     MinHeight="0"
                     Padding="2"
                     ui:TextBoxHelper.IsDeleteButtonVisible="False"
                     GotFocus="TextBox_GotFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveTitleCommand}" CommandParameter="{Binding Title}"/>
                    <KeyBinding Key="Escape" Command="{Binding CancelEditTitleCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    x:Name="SuspendButton"
                    Style="{StaticResource InlineButton}"
                    Command="{Binding SuspendCommand}"
                    ToolTip="Sleep this process"
                    Visibility="{Binding Path=IsSuspendButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    >
                    <fa:IconBlock Icon="Moon"/>
                </Button>
                <Button
                    x:Name="ThumbnailButton"
                    Style="{StaticResource InlineButton}"
                    Command="{Binding ThumbnailCommand}"
                    ToolTip="Show as floating thumbnail"
                    Visibility="{Binding Path=IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    >
                    <fa:IconBlock Icon="ExternalLinkAlt"/>
                </Button>
                <Button
                    x:Name="AcceptButton"
                    Style="{StaticResource InlineButton}" 
                    Command="{Binding SaveTitleCommand}"
                    CommandParameter="{Binding Title}"
                    Visibility="{Binding Path=IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                    >
                    <fa:IconBlock Icon="Check"/>
                </Button>
                <Button 
                    x:Name="CanceButton" 
                    Style="{StaticResource InlineButton}" 
                    Command="{Binding CancelEditTitleCommand}"
                    Visibility="{Binding Path=IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <fa:IconBlock Icon="Ban"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
