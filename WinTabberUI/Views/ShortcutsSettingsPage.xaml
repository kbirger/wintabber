<rxwpf:ReactivePage x:Class="WinTabberUI.Views.ShortcutsSettingsPage" x:TypeArguments="settingsvm:ShortcutsSettingsViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:controls="clr-namespace:WinTabber.UI.Common.Controls;assembly=WinTabber.UI.Common"
      xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"
      xmlns:rxwpf="clr-namespace:ReactiveUI;assembly=ReactiveUI.Wpf"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance settingsvm:ShortcutsSettingsViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShortcutsSettingsPage">
    <Page.Resources>
        <ResourceDictionary>

            <!-- One binding row: presenter when idle, capture box while editing. -->
            <DataTemplate x:Key="BindingRowTemplate" DataType="{x:Type settingsvm:ShortcutBindingViewModel}">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ShortcutPresenter
                        x:Name="Presenter"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Trigger="{Binding Trigger}" />

                    <controls:ShortcutCaptureBox
                        x:Name="CaptureBox"
                        Grid.Column="0"
                        Trigger="{Binding Trigger, Mode=TwoWay}"
                        TriggerSource="{Binding DataContext.TriggerSource, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        Visibility="Collapsed" />

                    <!-- Conflicts warn, they never block saving (§6.1). -->
                    <ui:FontIcon
                        x:Name="ConflictIcon"
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Foreground="#FFC42B1C"
                        Glyph="&#xE7BA;"
                        ToolTip="{Binding ConflictMessage}"
                        Visibility="Collapsed" />

                    <Button
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Command="{Binding EditCommand}"
                        Content="&#xE70F;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="Change" />

                    <Button
                        Grid.Column="3"
                        Margin="4,0,0,0"
                        Command="{Binding RemoveCommand}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="Remove" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="CaptureBox" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                        <Setter TargetName="ConflictIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CommandRowTemplate" DataType="{x:Type settingsvm:ShortcutCommandViewModel}">
                <ui:SettingsCard Margin="0,4,0,0" Header="{Binding DisplayName}">
                    <StackPanel MinWidth="320">
                        <ItemsControl ItemTemplate="{StaticResource BindingRowTemplate}" ItemsSource="{Binding Bindings}" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddCommand}" Content="+ Add shortcut" />
                            <Button Margin="8,0,0,0" Command="{Binding ResetCommand}" Content="Reset to default" />
                        </StackPanel>
                    </StackPanel>
                </ui:SettingsCard>
            </DataTemplate>

        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <HeaderedContentControl Margin="20" VerticalAlignment="Top" Foreground="White">
            <HeaderedContentControl.Header>
                <TextBlock FontSize="24">Shortcuts</TextBlock>
            </HeaderedContentControl.Header>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type settingsvm:ShortcutGroupViewModel}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <ItemsControl ItemTemplate="{StaticResource CommandRowTemplate}" ItemsSource="{Binding Commands}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ResetAllCommand}"
                    Content="Reset all shortcuts to defaults" />
            </StackPanel>
        </HeaderedContentControl>
    </ScrollViewer>
</rxwpf:ReactivePage>
