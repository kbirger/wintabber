<rxwpf:ReactivePage x:Class="WinTabberUI.Views.ShortcutsSettingsPage" x:TypeArguments="settingsvm:ShortcutsSettingsViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:controls="clr-namespace:WinTabber.UI.Common.Controls;assembly=WinTabber.UI.Common"
      xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"
      xmlns:rxwpf="clr-namespace:ReactiveUI;assembly=ReactiveUI.Wpf"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance settingsvm:ShortcutsSettingsViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShortcutsSettingsPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ShortcutEditButtonStyle and its brushes live here, not auto-merged like the
                     implicit ShortcutPresenter/ShortcutCaptureBox styles WPF loads by default-style
                     lookup — this is a plain-Button style, so it needs an explicit merge. -->
                <ResourceDictionary Source="/WinTabber.UI.Common;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Editing and deleting both happen in ShortcutCaptureDialog (opened from code-behind).
                 The whole combination is one clickable frame — there is no separate pencil icon. -->
            <DataTemplate x:Key="BindingRowTemplate" DataType="{x:Type settingsvm:ShortcutBindingViewModel}">
                <StackPanel Margin="0,2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OnEditShortcutClick" Style="{StaticResource ShortcutEditButtonStyle}" ToolTip="Click to change">
                        <controls:ShortcutPresenter EmptyText="Click to set shortcut" Trigger="{Binding Trigger}" />
                    </Button>

                    <!-- Conflicts warn, they never block saving (§6.1). -->
                    <ui:FontIcon
                        x:Name="ConflictIcon"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Foreground="#FFC42B1C"
                        Glyph="&#xE7BA;"
                        ToolTip="{Binding ConflictMessage}"
                        Visibility="Collapsed" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                        <Setter TargetName="ConflictIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CommandRowTemplate" DataType="{x:Type settingsvm:ShortcutCommandViewModel}">
                <ui:SettingsCard Margin="0,4,0,0" Header="{Binding DisplayName}" Description="{Binding Desscription}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Icon="{Binding Icon}" />
                    </ui:SettingsCard.HeaderIcon>
                    <StackPanel MinWidth="320">
                        <ItemsControl ItemTemplate="{StaticResource BindingRowTemplate}" ItemsSource="{Binding Bindings}" HorizontalAlignment="Right" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button
                                Width="40"
                                Height="28"
                                Click="OnAddShortcutClick"                                
                                ToolTip="Add shortcut">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Add_32_Filled}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ui:SettingsCard>
            </DataTemplate>

        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <HeaderedContentControl Margin="20" VerticalAlignment="Top" Foreground="White">
            <HeaderedContentControl.Header>
                <TextBlock FontSize="24">Shortcuts</TextBlock>
            </HeaderedContentControl.Header>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type settingsvm:ShortcutGroupViewModel}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <ItemsControl ItemTemplate="{StaticResource CommandRowTemplate}" ItemsSource="{Binding Commands}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ResetAllCommand}"
                    Content="Reset all shortcuts to defaults" />
            </StackPanel>
        </HeaderedContentControl>
    </ScrollViewer>
</rxwpf:ReactivePage>
