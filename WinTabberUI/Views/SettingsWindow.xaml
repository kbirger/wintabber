<controlzex:WindowChromeWindow x:Class="WinTabberUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
        xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"
        xmlns:rxui="http://reactiveui.net"                      
        xmlns:local="clr-namespace:WinTabberUI.Views"
        xmlns:chrome="clr-namespace:WinTabberUI.Chrome"
        xmlns:controlzex="urn:controlzex"
                               PreferDWMBorderColor="true"
                               ResizeBorderThickness="10"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:WinTabberUI.Views"
                               WindowStyle="None"
                               
                               controlzex:WindowBackdropManager.BackdropType="Mica"
                               GlowColor="{DynamicResource ControlzEx.Colors.AccentBaseColor}"
                               CaptionColor="{DynamicResource ControlzEx.Colors.AccentBaseColor}"
                               NCNonActiveBrush="{Binding Source={x:Static SystemColors.WindowFrameBrush}}"
                               NonActiveGlowColor="LightGray"
                               WindowStartupLocation="CenterScreen"
        Title="Settings" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
  
    <chrome:CustomChrome.CustomChrome>
        <!--<WindowChrome CaptionHeight="32"  ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />-->
        <chrome:CustomChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
    </chrome:CustomChrome.CustomChrome>

    <!--<chrome:AcrylicChrome.AcrylicChrome>
        <chrome:AcrylicChrome AccentState="ACCENT_ENABLE_ACRYLICBLURBEHIND" CornerPreference="DWMWCP_ROUND" />
    </chrome:AcrylicChrome.AcrylicChrome>-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Column="0">
            <ListView x:Name="SettingsCategoryList" Style="{StaticResource ResourceKey=SettingsSectionsList}" ItemsSource="{Binding Sections}" SelectedItem="{Binding Mode=TwoWay, Path=SelectedView}">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type settingsvm:SettingsViewModelBase}">
                        <TextBlock Text="{Binding Name}" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,100,0,5"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2">
            <Button 
                Content="Save" 
                Width="75" 
                Height="25" 
                Margin="5" 
                HorizontalAlignment="Right" 
                IsDefault="True"
                x:Name="Save"/>
        </DockPanel>
        <Frame DataContext="{Binding SelectedView}" Content="{Binding}" Grid.Column="1" Name="SettingsFrame" NavigationUIVisibility="Hidden">
            <Frame.Resources>
                <DataTemplate DataType="{x:Type settingsvm:AppearanceSettingsViewModel}">
                    <views:AppearanceSettingsPage />
                </DataTemplate>
            </Frame.Resources>
        </Frame>
    </Grid>
</controlzex:WindowChromeWindow>
