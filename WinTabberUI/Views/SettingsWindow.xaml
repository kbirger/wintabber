<Window x:Class="WinTabberUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round"
        xmlns:rxui="http://reactiveui.net"                      
        xmlns:local="clr-namespace:WinTabberUI.Views"
        xmlns:chrome="clr-namespace:WinTabber.UI.Common.Chrome;assembly=WinTabber.UI.Common"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:WinTabberUI.Views"
        ui:WindowHelper.SystemBackdropType="Mica"

        
        Title="Settings" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
  
    <!--<chrome:CustomChrome.CustomChrome>-->
        <!--<WindowChrome CaptionHeight="32"  ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />-->
        <!--<chrome:CustomChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"/>-->
    <!--</chrome:CustomChrome.CustomChrome>-->
    <!--<chrome:AcrylicChrome.AcrylicChrome>
        <chrome:AcrylicChrome AccentState="ACCENT_ENABLE_ACRYLICBLURBEHIND" CornerPreference="DWMWCP_ROUND" />
    </chrome:AcrylicChrome.AcrylicChrome>-->
    <ui:NavigationView 
        IsBackButtonVisible="Collapsed" 
        PaneDisplayMode="Left" 
        OpenPaneLength="240"
        MenuItemsSource="{Binding Sections}" 
        SelectedItem="{Binding Mode=TwoWay, Path=SelectedView}">
        <ui:NavigationView.MenuItemTemplate>
            <DataTemplate>
                <ui:NavigationViewItem>
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{Binding Icon}"/>
                    </ui:NavigationViewItem.Icon>
                    <TextBlock Text="{Binding Name}" />
                </ui:NavigationViewItem>
            </DataTemplate>
        </ui:NavigationView.MenuItemTemplate>
        <ui:NavigationView.MenuItems>
            
            <ui:NavigationViewItem Content="Home">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Home}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem Content="Apps">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OEM}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem Content="Games">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Game}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

        </ui:NavigationView.MenuItems>

        <ui:Frame DataContext="{Binding SelectedView}"
                  Content="{Binding}" 
                  Name="SettingsFrame" NavigationUIVisibility="Hidden"
                  >
            <ui:Frame.Resources>
                <DataTemplate DataType="{x:Type settingsvm:AppearanceSettingsViewModel}">
                    <views:AppearanceSettingsPage />

                </DataTemplate>
                <DataTemplate DataType="{x:Type settingsvm:GeneralSettingsViewModel}">
                    <views:GeneralSettingsPage/>
                </DataTemplate>
            </ui:Frame.Resources>
            
        </ui:Frame>
    </ui:NavigationView>
</Window>
