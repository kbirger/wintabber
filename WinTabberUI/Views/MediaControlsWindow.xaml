<reactiveui:ReactiveWindow x:TypeArguments="vm:MediaControlsViewModel" x:Class="WinTabberUI.MediaControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WinTabberUI.ValueConverters"                    

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="clr-namespace:WinTabberUI.Chrome"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:mdi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF" 
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"

        xmlns:local="clr-namespace:WinTabberUI"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
        xmlns:b="clr-namespace:WinTabberUI.Behaviors"
        xmlns:reactiveui="http://reactiveui.net"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="#01000000"
        WindowStyle="None"
        SizeToContent="Height"
        Topmost="true"
        ShowActivated="true"
        ShowInTaskbar="False"
        Focusable="True"
        WindowStartupLocation="CenterScreen"
        Padding="20"
        Width="700"
        MinHeight="370"
        d:DataContext="{d:DesignInstance vm:MediaControlsViewModel}"
        IsHitTestVisible="True"
        Title="MediaControlsWindow">
    <chrome:AcrylicChrome.AcrylicChrome>
        <chrome:AcrylicChrome AccentState="ACCENT_ENABLE_BLURBEHIND" CornerPreference="DWMWCP_ROUND" UnderStratumColor="#55ff0000" />
    </chrome:AcrylicChrome.AcrylicChrome>
    <Window.Resources>
        <DataTemplate DataType="vm:MediaControlsViewModel.DeviceItem" x:Key="DeviceItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Margin="4"/>
                <TextBlock Text="{Binding IsSelected}" Margin="4"/>
            </StackPanel>
        </DataTemplate>
        <c:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <DataTemplate x:Key="PlayButton">
            <TextBlock>
            <mdi:MaterialIconExt Kind="Play" Animation="Pulse"/>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="PauseButton">
            <TextBlock>
                <mdi:MaterialIconExt Kind="Pause" Animation="Pulse"/>
            </TextBlock>

        </DataTemplate>
        <Style TargetType="Button" x:Key="MediaButton">
            <Setter Property="Width" Value="48"/>

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0, 0"/>
            <Setter Property="FontFamily" Value="Webdings" />
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Background" Value="#dd666666"/>
                    </Trigger.Setters>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="PlayPauseMediaButton" BasedOn="{StaticResource MediaButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PauseButton}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                    <Setter Property="ContentTemplate" Value="{StaticResource PlayButton}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ListBox}" x:Key="ToggleButtonList">
            <!-- ControlTemplate taken from MSDN http://msdn.microsoft.com/en-us/library/ms754242.aspx -->
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="vm:AudioDeviceSelectorViewModel.DeviceItem" >
                        <TextBlock Text="{Binding Name}" Margin="4"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Name="Border" Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="2">
                            <ItemsControl>
                                <WrapPanel Margin="0" Focusable="false" IsItemsHost="True"/>
                            </ItemsControl>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="Border" Property="Background"
            Value="Transparent" />
                                <Setter TargetName="Border" Property="BorderBrush"
            Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListBoxItem}" >
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ToggleButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" Foreground="White" Padding="10,5" FontSize="10">
                                        <ContentPresenter />
                                    </ToggleButton>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <AdornerDecorator>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ComboBox Grid.Row="0" ItemsSource="{Binding Sessions}" x:Name="SessionSelector" SelectedItem="{Binding ActiveSession}">
                <i:Interaction.Behaviors>
                    <b:HintBehavior HintText="A"/>
                </i:Interaction.Behaviors>
                <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:MediaControlsViewModel.SessionItem">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Height="16" Width="16" Margin="0,0,10,0" Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid Margin="25" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="64" Height="64" Margin="0" Source="{Binding Thumbnail}" VerticalAlignment="top"/>
            <StackPanel Margin="10, 0, 0, 0" Grid.Column="1" VerticalAlignment="Top">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="{Binding Title}" FontWeight="UltraBold"  Height="24" MinWidth="60"/>
                <TextBlock Text="{Binding ArtistName}"/>
                <TextBlock Text="{Binding AlbumTitle}"/>
                <!--<TextBlock Text="{Binding Position}"/>-->
                <!--<TextBlock Text="{Binding Duration}"/>-->

            </StackPanel>

        </Grid>
        <UniformGrid Margin="20" Columns="3" Grid.Row="2">
                <Button Style="{StaticResource MediaButton}" Command="{Binding Prev}">
                    <i:Interaction.Behaviors>
                        <b:HintBehavior HintText="B"/>
                    </i:Interaction.Behaviors>
                <mdi:MaterialIconExt Kind="SkipPrevious"/>
            </Button>
            <Button Style="{StaticResource PlayPauseMediaButton}" Command="{Binding PlayPause}">
                    <i:Interaction.Behaviors>
                        <b:HintBehavior HintText="P"/>
                    </i:Interaction.Behaviors>
                    <mdi:MaterialIconExt Kind="PlayPause"/>
            </Button>
            <Button Style="{StaticResource MediaButton}" Command="{Binding Next}">
                    <i:Interaction.Behaviors>
                        <b:HintBehavior HintText="F"/>
                    </i:Interaction.Behaviors>
                    <mdi:MaterialIconExt Kind="SkipNext"/>
            </Button>
        </UniformGrid>
        <ListBox Margin="25, 5" Grid.Row="3" ItemsSource="{Binding Playback.Devices}" SelectedItem="{Binding Playback.SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionMode="Single" Style="{StaticResource ToggleButtonList}"  SelectionChanged="ListBox_SelectionChanged">
                <i:Interaction.Behaviors>
                    <b:HintBehavior HintText="S"/>
                </i:Interaction.Behaviors>
                <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:AudioDeviceSelectorViewModel.DeviceItem">
                    <TextBlock Text="{Binding Name}" Margin="4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Margin="25,5" Grid.Row="4" ItemsSource="{Binding Recording.Devices}" SelectedItem="{Binding Recording.SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionMode="Single" Style="{StaticResource ToggleButtonList}" SelectionChanged="ListBox_SelectionChanged" >
                <i:Interaction.Behaviors>
                    <b:HintBehavior HintText="R"/>
                </i:Interaction.Behaviors>
            </ListBox>

        </Grid>
    </AdornerDecorator>
</reactiveui:ReactiveWindow>
