<rxui:ReactivePage x:Class="WinTabberUI.Views.AppearanceSettingsPage"
      x:TypeArguments="settingsvm:AppearanceSettingsViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
      xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"

      xmlns:rxui="http://reactiveui.net"

      xmlns:local="clr-namespace:WinTabberUI.Views"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance vm:AppearanceSettingsViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppearanceSettingsPage">

    <Grid>
        <HeaderedContentControl Margin="20" VerticalAlignment="Top" Foreground="White">
            <HeaderedContentControl.Header>
                <TextBlock FontSize="24">Scaling</TextBlock>
            </HeaderedContentControl.Header>
            <StackPanel>
                <HeaderedContentControl Header="UI Scale">
                    <Slider Minimum="0.5" Maximum="3.0" Value="{Binding ScaleFactor, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                </HeaderedContentControl>
            </StackPanel>
        </HeaderedContentControl>

    </Grid>
</rxui:ReactivePage>
