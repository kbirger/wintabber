<rxui:ReactivePage x:Class="WinTabberUI.Views.AppearanceSettingsPage"
      x:TypeArguments="settingsvm:AppearanceSettingsViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
      xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"

      xmlns:rxui="http://reactiveui.net"

      xmlns:local="clr-namespace:WinTabberUI.Views"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance settingsvm:AppearanceSettingsViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppearanceSettingsPage">

    <Grid>
        <HeaderedContentControl Margin="20" VerticalAlignment="Top" Foreground="White">
            <HeaderedContentControl.Header>
                <TextBlock FontSize="24">Scaling</TextBlock>
            </HeaderedContentControl.Header>
            <StackPanel>
                <ui:SettingsCard Header="Scale with display density" Description="Scale Window Selector tiles with screen DPI">
                    <ui:ToggleSwitch IsOn="{Binding ScaleToDpi}" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="UI Scale" Description="Scale of certain UI elements, on top of any other scaling" ContentAlignment="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0.5" Maximum="3.0" Value="{Binding ScaleFactor, Mode=TwoWay}" 
                            TickFrequency="0.1" 
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            TickPlacement="BottomRight"/>
                        <TextBox Grid.Column="1" ui:TextBoxHelper.IsDeleteButtonVisible="False" Text="{Binding ScaleFactor, Mode=TwoWay}" 
                             Width="10" Margin="10,0,0,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"/>
                    </Grid>
                </ui:SettingsCard>
                <ui:SettingsCard Description="Width of Window Selector tiles in DIP" Header="Window Selector Tile Width" ContentAlignment="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="250" Maximum="500" Value="{Binding WindowTileWidth, Mode=TwoWay}"
                            TickFrequency="10" 
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            TickPlacement="BottomRight"/>
                        <TextBox Grid.Column="1" ui:TextBoxHelper.IsDeleteButtonVisible="False" Text="{Binding WindowTileWidth, Mode=TwoWay}" 
                             Width="10" Margin="10,0,0,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"/>
                    </Grid>
                </ui:SettingsCard>
            </StackPanel>
        </HeaderedContentControl>

    </Grid>
</rxui:ReactivePage>
