<winuiex:WindowEx
    x:Class="WinTabberUI.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    xmlns:local="using:WinTabberUI.Controls"
    xmlns:vm="using:WinTabber.ViewModels"
    Title="DockWindow"
    Width="200"
    IsTitleBarVisible="False"
    IsShownInSwitchers="False"
    IsResizable="False"
    IsAlwaysOnTop="True"
>
    <!--
        IsAlwaysOnTop="True" above ports the WPF resource dictionary's Topmost="True" setter — see
        Resources/DockWindowResources.xaml for the full mapping of that dictionary's WPF Window
        style onto this element's attributes and DockWindow.xaml.cs (WinUI 3's Window/WindowEx
        cannot be a ResourceDictionary Style TargetType at all, so none of that dictionary's content
        survives as an actual merged resource).
    -->
    <Grid Padding="10" Margin="10">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Resources/DockWindowResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <ListView
            x:Name="WindowsList"
            ItemsSource="{x:Bind ViewModel.Windows, Mode=OneWay}"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
        >
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        ItemsStackPanel, not the brief's plain StackPanel (WPF's original ItemsPanel,
                        ported literally in an earlier draft of this file). VERIFIED via a temporary
                        diagnostic log: with a plain StackPanel, ListView.ContainerContentChanging
                        (DockWindow.xaml.cs's only way to wire WindowThumbnail.TargetWindow) never
                        fires at all — StackPanel doesn't participate in WinUI 3's virtualizing
                        container-recycling pipeline that raises that event, so every thumbnail's
                        TargetWindow stayed permanently null and DwmRegisterThumbnail never even
                        attempted. Switching to WinUI 3's own virtualizing ItemsStackPanel (behaviorally
                        equivalent for a simple vertical list) fixed it: ContainerContentChanging now
                        fires per item and DwmRegisterThumbnail succeeds (hr=0) for each one.
                    -->
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WindowItem">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Viewbox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Uniform">
                            <local:WindowThumbnail x:Name="PART_Thumbnail" Source="{x:Bind Handle, Mode=OneWay}" />
                        </Viewbox>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</winuiex:WindowEx>
