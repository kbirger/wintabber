<rxwpf:ReactivePage x:Class="WinTabberUI.Views.GeneralSettingsPage" x:TypeArguments="settingsvm:GeneralSettingsViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:local="clr-namespace:WinTabberUI.Views"
      xmlns:c="clr-namespace:WinTabber.UI.Common.ValueConverters;assembly=WinTabber.UI.Common"
                    
      xmlns:vm="clr-namespace:WinTabberUI.ViewModels"
      xmlns:settingsvm="clr-namespace:WinTabberUI.ViewModels.Settings"

      xmlns:rxwpf="clr-namespace:ReactiveUI;assembly=ReactiveUI.Wpf"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance settingsvm:GeneralSettingsViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GeneralSettingsPage">
    <Page.Resources>
        <ResourceDictionary>
            <c:EnumValuesConverter x:Key="EnumValuesConverter" />
            <c:StringToEnumConverter x:Key="StringToEnumConverter" />
            <c:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Top">
            <HeaderedContentControl Foreground="White">
                <HeaderedContentControl.Header>
                    <TextBlock FontSize="24">General</TextBlock>
                </HeaderedContentControl.Header>
                <StackPanel>
                    <ui:SettingsCard Header="Startup mode">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xe7f4;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="220" x:Name="StartupList"
                                VerticalAlignment="Center"
                                FontSize="14"
                                ItemsSource="{Binding StartupModes}"
                                SelectedValue="{Binding Path=StarupMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="Thumbnail resize mode" Margin="0,8,0,0"
                            Description="What resizing a floating window thumbnail does">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xe740;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="220" x:Name="ThumbnailResizeModeList"
                                VerticalAlignment="Center"
                                FontSize="14"
                                ItemsSource="{Binding ThumbnailResizeModes}" />
                    </ui:SettingsCard>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Margin="0,20,0,0" Foreground="White">
                <HeaderedContentControl.Header>
                    <TextBlock FontSize="24">Features</TextBlock>
                </HeaderedContentControl.Header>
                <StackPanel>
                    <ui:SettingsCard Header="Window suspend"
                            Description="The sleep button on a window tile, its shortcut, the suspended-windows shortcut, and the suspended-windows bar">
                        <ui:ToggleSwitch IsOn="{Binding EnableWindowSuspension}" />
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="Media controls" Margin="0,8,0,0"
                            Description="The media controls shortcut and window, and the preload of installed apps and audio devices it uses">
                        <ui:ToggleSwitch IsOn="{Binding EnableMediaControls}" />
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="Close application windows" Margin="0,8,0,0"
                            Description="The close button on the window selector and the close-application-windows shortcut">
                        <ui:ToggleSwitch IsOn="{Binding EnableCloseApplicationWindows}" />
                    </ui:SettingsCard>
                    <ui:SettingsExpander Header="Focus select" Margin="0,8,0,0"
                            Description="Hold the modifier below while selecting a window to minimize the others"
                            IsExpanded="False"
                            IsEnabled="{Binding EnableFocusSelect}">
                        <ui:ToggleSwitch IsOn="{Binding EnableFocusSelect}" />
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="Modifier"
                                    Description="Which modifier, held at selection, triggers Focus Select">
                                <ComboBox MinWidth="220" x:Name="FocusSelectModifierList"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        ItemsSource="{Binding FocusSelectModifiers}"
                                        SelectedValue="{Binding Path=FocusSelectModifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="Scope"
                                    Description="Which windows get minimized: only the ones the switcher showed, or every other window">
                                <ComboBox MinWidth="220" x:Name="FocusSelectScopeList"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        ItemsSource="{Binding FocusSelectScopes}"
                                        SelectedValue="{Binding Path=FocusSelectScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>
                    <ui:SettingsCard Header="Elevation backend" Margin="0,8,0,0"
                            Description="How WinTabber closes or minimizes windows belonging to an elevated (admin) process">
                        <ComboBox MinWidth="220" x:Name="ElevationBackendList"
                                VerticalAlignment="Center"
                                FontSize="14"
                                ItemsSource="{Binding ElevationBackends}"
                                SelectedValue="{Binding Path=ElevationBackend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="gsudo not found" Margin="0,8,0,0"
                            Description="Install gsudo via winget to use it as the elevation backend"
                            Visibility="{Binding ShowGsudoInstallPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Install" Command="{Binding InstallGsudoCommand}" />
                    </ui:SettingsCard>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </Grid>
</rxwpf:ReactivePage>
