<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
		<OutputType>WinExe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Platform>x64</Platform>

		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="fontawesome.sharp" Version="6.6.0" />
		<PackageReference Include="GlobalHotKeys.Windows" Version="0.1.0" />
		<PackageReference Include="Material.Icons.WPF" Version="2.4.1" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.205">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MouseKeyHook" Version="5.7.1" />
		<PackageReference Include="windowsinput" Version="6.4.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WinTabber.API\WinTabber.API.csproj" />
		<ProjectReference Include="..\WinTabber.Events\WinTabber.Events.csproj" />
		<ProjectReference Include="..\WinTabber.GameBar\WinTabber.GameBar.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Update="NativeMethods.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AdditionalFiles>
	</ItemGroup>

	<ItemGroup>
		<None Update="Fonts\fa-7-regular-400.otf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Fonts\fa-7-solid-400.otf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Icons\ban.svg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Icons\check.svg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Icons\pen.svg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
