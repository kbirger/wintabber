<UserControl
    x:Class="WinTabber.UI.Media.UserControls.VolumeControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:c="using:WinTabber.UI.Common.ValueConverters"
    mc:Ignorable="d"
>
    <!--
        Deviations from the WPF original, following EditableTextBlock.xaml's proven precedent:
        - Converters (FloatToPercentageConverter, InverseBoolConverter) are declared locally
          rather than merging WinTabber.UI.Common's ValueConvertersResources.xaml by ms-appx
          Source - that dictionary carries an x:Class, meant to be instantiated, not merged.
        - b:HintBehavior.HintText is dropped (2 uses). The hint-overlay system remains its own
          deferred, unresearched Phase 2c task - no ported window uses it yet.
        - MuteToggle's ControlTemplate is rewritten with VisualStateManager in place of WPF's
          Style.Triggers/ControlTemplate.Triggers - not supported in WinUI 3.
        - Slider drops TickFrequency/AutoToolTipPlacement/AutoToolTipPrecision/IsMoveToPointEnabled
          - none exist on WinUI 3's Slider; StepFrequency is the nearest equivalent, and WinUI 3's
          Slider shows a drag tooltip by default with no AutoToolTip properties needed.
        - Icon glyphs (TODO(icon)): Segoe Fluent codepoints chosen for a visually distinct
          volume/mute pair, not verified against the WPF original's Material Design icons.
    -->
    <UserControl.Resources>
        <c:FloatToPercentageConverter x:Key="FloatToPercentageConverter" />
        <c:InverseBoolConverter x:Key="InverseBoolConverter" />
        <!-- CommonStates uses the framework's own combined state names (Checked, CheckedPointerOver,
             CheckedPressed), matching the real ToggleButton default template shipped in the Windows
             App SDK, see PlayPauseMediaButton in MediaControlsWindow.xaml for the full root-cause
             explanation. A separate CheckStates group with plain Checked/Unchecked (the earlier,
             wrong approach here) silently fails to match GoToState("CheckedPointerOver") and similar
             calls, breaking both the glyph swap and hover. -->
        <Style x:Key="MuteToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#22666666" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#dd777777" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Icon.Glyph" Value="&#xE74F;" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#22666666" />
                                            <Setter Target="Icon.Glyph" Value="&#xE74F;" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#dd777777" />
                                            <Setter Target="Icon.Glyph" Value="&#xE74F;" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon x:Name="Icon" FontSize="16" Glyph="&#xE767;" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Slider
            Minimum="0"
            Maximum="100"
            StepFrequency="5"
            IsEnabled="{Binding CanSetVolume}"
            Value="{Binding Volume, Converter={StaticResource FloatToPercentageConverter}, Mode=TwoWay}"
        />
        <ToggleButton
            Style="{StaticResource MuteToggle}"
            Margin="7 0 0 0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            IsChecked="{Binding IsMuted, Mode=OneWay}"
            Command="{Binding SetMuted}"
            CommandParameter="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}"
        />
    </Grid>
</UserControl>
