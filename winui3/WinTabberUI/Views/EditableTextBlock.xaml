<!-- winui3/WinTabberUI/Views/EditableTextBlock.xaml -->
<local:EditableTextBlockBase
    x:Class="WinTabberUI.Views.EditableTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTabberUI.Views"
    xmlns:c="using:WinTabber.UI.Common.ValueConverters"
    IsTabStop="False"
>
    <!--
        Deviations from the brief (see task-4b.2-report.md for the full list):
        - Focusable="False" (the brief's literal sample) is a WPF-only property with no WinUI 3
          equivalent — UIElement has no Focusable member there. Replaced with IsTabStop="False",
          the nearest WinUI 3 equivalent, or this file would not compile.
        - This file declares its converters locally (InverseBoolConverter, BoolToVisibilityConverter,
          InverseBoolToVisibilityConverter, BoolToThicknessConverter, and a configured
          BorderBrushConverter instance) rather than merging WinTabber.UI.Common's
          ValueConvertersResources.xaml by ms-appx Source, per ShortcutsSettingsPage.xaml's actual
          precedent (it merges Generic.xaml for styles but declares c:BoolToVisibilityConverter
          inline) — nothing in this tree merges ValueConvertersResources.xaml by Source, and that
          dictionary carries an x:Class (meant to be instantiated, not merged), so local declaration
          is the proven-safe path.
        - Border.Background (bound to IsMouseOver in WPF) and Border.BorderThickness (bound to
          IsEditing in WPF, via BoolToThicknessConverter) were both silently absent from the brief's
          Step 2 code sample, even though the brief's own "Real conversions" item 1 explicitly
          requires the Background/IsPointerOver conversion. Restored both: Background binds to the
          code-behind IsPointerOver property (toggled by PointerEntered/PointerExited, per item 1)
          through a locally configured BoolToBrushConverter matching the WPF original's
          EditableTextBlockResources.xaml colors (EditBrush=#ff666666, ViewBrush=Transparent — the
          shared ValueConvertersResources.xaml's keyed BoolToBrushConverter uses the class's White
          default, which would have been visibly wrong here). BorderThickness binds to
          ViewModel.IsEditing via BoolToThicknessConverter, same as the WPF original.
    -->
    <local:EditableTextBlockBase.Resources>
        <c:InverseBoolConverter x:Key="InverseBoolConverter" />
        <c:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <c:BoolToThicknessConverter x:Key="BoolToThicknessConverter" />
        <c:BoolToBrushConverter x:Key="BorderBrushConverter" EditBrush="#ff666666" ViewBrush="Transparent" />

        <!-- Ported from the WPF original's EditableTextBlockResources.xaml "InlineButton" style,
             declared locally rather than merged, matching this file's own established precedent
             above. Never ported before this: SuspendButton/ThumbnailButton/AcceptButton/CancelButton
             had been rendering with the plain default WinUI 3 Button chrome (full padding, default
             hover/pressed visuals) instead of this transparent-until-hover, minimal-chrome look. -->
        <Style x:Key="InlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                        >
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#dd666666" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#dd666666" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="#dd333333" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:EditableTextBlockBase.Resources>

    <Border
        x:Name="BorderContainer"
        CornerRadius="4"
        Background="{x:Bind IsPointerOver, Mode=OneWay, Converter={StaticResource BorderBrushConverter}}"
        BorderThickness="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToThicknessConverter}}"
        BorderBrush="Gray"
        PointerEntered="OnPointerEnteredRoot"
        PointerExited="OnPointerExitedRoot"
    >
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="TitleTextBox"
                Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
                BorderThickness="0"
                Foreground="White"
                Background="Transparent"
                IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                MinHeight="0"
                Padding="2"
                TextChanged="OnTitleTextBoxTextChanged"
                KeyDown="OnTitleTextBoxKeyDown"
            />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    x:Name="SuspendButton"
                    Style="{StaticResource InlineButton}"
                    Command="{x:Bind ViewModel.SuspendCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Sleep this process"
                    Visibility="{x:Bind ViewModel.IsSuspendButtonVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE708;" />
                </Button>
                <Button
                    x:Name="ThumbnailButton"
                    Style="{StaticResource InlineButton}"
                    Command="{x:Bind ViewModel.ThumbnailCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Show as floating thumbnail"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xEA5F;" />
                </Button>
                <Button
                    x:Name="AcceptButton"
                    Style="{StaticResource InlineButton}"
                    Command="{x:Bind ViewModel.SaveTitleCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind ViewModel.Title, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xF78C;" />
                </Button>
                <Button
                    x:Name="CancelButton"
                    Style="{StaticResource InlineButton}"
                    Command="{x:Bind ViewModel.CancelEditTitleCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xF78A;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</local:EditableTextBlockBase>
