<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WinTabber.UI.Common.Controls"
    >

    <SolidColorBrush x:Key="ShortcutChipBackgroundBrush" Color="#22808080" />
    <SolidColorBrush x:Key="ShortcutChipBorderBrush" Color="#44808080" />
    <SolidColorBrush x:Key="ShortcutEmptyForegroundBrush" Color="#88808080" />
    <SolidColorBrush x:Key="ShortcutValidationForegroundBrush" Color="#FFC42B1C" />

    <!-- Chip rendering exists in exactly one place. ShortcutCaptureBox hosts a ShortcutPresenter
         rather than duplicating this template. -->
    <DataTemplate x:Key="ShortcutChipTemplate">
        <Border
            Margin="0,0,4,0"
            Padding="6,2"
            Background="{DynamicResource ShortcutChipBackgroundBrush}"
            BorderBrush="{DynamicResource ShortcutChipBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding Text}" />
        </Border>
    </DataTemplate>

    <Style TargetType="{x:Type controls:ShortcutPresenter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ShortcutPresenter}">
                    <Grid>
                        <ItemsControl
                            x:Name="PART_Chips"
                            ItemTemplate="{StaticResource ShortcutChipTemplate}"
                            ItemsSource="{TemplateBinding Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type controls:ShortcutPresenter}}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            x:Name="PART_Empty"
                            VerticalAlignment="Center"
                            FontStyle="Italic"
                            Foreground="{DynamicResource ShortcutEmptyForegroundBrush}"
                            Text="{TemplateBinding EmptyText}"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEmpty" Value="True">
                            <Setter TargetName="PART_Empty" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Chips" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ShortcutCaptureBox}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ShortcutCaptureBox}">
                    <Border
                        Padding="4,2"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ShortcutChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <controls:ShortcutPresenter
                                x:Name="PART_Presenter"
                                Trigger="{Binding Trigger, RelativeSource={RelativeSource TemplatedParent}}" />

                            <StackPanel x:Name="PART_Capturing" Orientation="Horizontal" Visibility="Collapsed">
                                <ItemsControl
                                    ItemTemplate="{StaticResource ShortcutChipTemplate}"
                                    ItemsSource="{TemplateBinding PendingChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource ShortcutEmptyForegroundBrush}"
                                    Text="Press a shortcut… (Esc to cancel)" />
                            </StackPanel>

                            <TextBlock
                                x:Name="PART_Validation"
                                FontSize="11"
                                Foreground="{DynamicResource ShortcutValidationForegroundBrush}"
                                Text="{TemplateBinding ValidationMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCapturing" Value="True">
                            <Setter TargetName="PART_Capturing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Presenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding ValidationMessage, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter TargetName="PART_Validation" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
