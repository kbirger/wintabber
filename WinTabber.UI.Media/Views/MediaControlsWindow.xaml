<reactiveui:ReactiveWindow
    x:TypeArguments="vm:MediaControlsViewModel"
    x:Class="WinTabberUI.MediaControlsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:WinTabber.UI.Common.ValueConverters;assembly=WinTabber.UI.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chrome="clr-namespace:WinTabber.UI.Common.Chrome;assembly=WinTabber.UI.Common"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:mdi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:vm="clr-namespace:WinTabber.UI.Media.ViewModels"
    xmlns:b="clr-namespace:WinTabber.UI.Common.Behaviors;assembly=WinTabber.UI.Common"
    xmlns:reactiveui="http://reactiveui.net"
    mc:Ignorable="d"
    AllowsTransparency="True"
    Background="#30000000"
    WindowStyle="None"
    SizeToContent="Height"
    Topmost="true"
    ShowActivated="true"
    ShowInTaskbar="False"
    Focusable="True"
    WindowStartupLocation="CenterScreen"
    Padding="20"
    Width="700"
    MinHeight="221"
    d:DataContext="{d:DesignInstance vm:MediaControlsViewModel}"
    xmlns:ca="clr-namespace:WinTabber.Api.Media.CoreAudio.Dtos;assembly=WinTabber.Api.Media"
    IsHitTestVisible="True"
    Title="MediaControlsWindow"
>
    <chrome:AcrylicChrome.AcrylicChrome>
        <chrome:AcrylicChrome
            AccentState="ACCENT_ENABLE_BLURBEHIND"
            CornerPreference="DWMWCP_ROUND"
            UnderStratumColor="#55ff0000"
        />
    </chrome:AcrylicChrome.AcrylicChrome>
    <i:Interaction.Behaviors>
        <b:HintBehavior />
    </i:Interaction.Behaviors>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#22000000" />
        <DataTemplate x:Key="DeviceItemTemplate" DataType="ca:DeviceDto">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DeviceName}" Margin="4" />
            </StackPanel>
        </DataTemplate>
        <c:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <DataTemplate x:Key="PlayButton">
            <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                <!--<mdi:MaterialIconExt Kind="Play" Animation="Pulse" />-->
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Pause_16_Filled}" />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="PauseButton">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
            >
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Pause_16_Filled}" />
                <!--<mdi:MaterialIconExt Kind="Pause" Animation="Pulse"/>-->
            </TextBlock>
        </DataTemplate>

        <Style TargetType="Button" x:Key="MediaButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0, 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                        >
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                            />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Background" Value="#22666666" />
                    </Trigger.Setters>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                    From="#dd666666"
                                    To="#dd777777"
                                    Duration="0:0:0.1"
                                />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                    To="Transparent"
                                    Duration="0:0:0.1"
                                />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="PlayPauseMediaButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            <!--<Setter Property="Foreground" Value="Red"/>-->
            <Setter Property="FontSize" Value="60" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0, 0" />
            <!--<Setter Property="FontFamily" Value="Webdings" />-->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border
    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
    CornerRadius="4"
>
                            <!--<mdi:MaterialIcon Kind="VolumeHigh" x:Name="Icon" />-->
                            <!--<ui:FontIcon x:Name="Icon" FontSize="30" Icon="{x:Static ui:FluentSystemIcons.PlantCattail_20_Filled}"/>-->
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Icon" Property="Icon" Value="{x:Static ui:FluentSystemIcons.PlantCattail_20_Filled}"/>
                            </DataTrigger>-->
                            <!--<Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Icon" Value="{x:Static ui:FluentSystemIcons.PauseCircle_20_Filled}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Icon" Property="Icon" Value="{x:Static ui:FluentSystemIcons.PlayCircle_48_Filled}"/>
                            </Trigger>-->
                            <!--<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                <Setter TargetName="Icon" Property="Icon" Value="{x:Static ui:FluentSystemIcons.PlayCircle_48_Filled}"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Content">
                            <Setter.Value>
                                <ui:FontIcon  FontSize="32" Icon="{x:Static ui:FluentSystemIcons.PauseCircle_32_Filled}"/>

                            </Setter.Value>
                        </Setter>
                    </Trigger.Setters>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                        <Trigger.Setters>
                        <Setter Property="Content">
                            <Setter.Value>
                                <ui:FontIcon FontSize="32" Icon="{x:Static ui:FluentSystemIcons.PlayCircle_28_Filled}"/>                                
                            </Setter.Value>
                        </Setter>
                        </Trigger.Setters>
                    </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Background" Value="#22666666" />
                    </Trigger.Setters>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                        From="#dd666666"
                        To="#dd777777"
                        Duration="0:0:0.1"
                    />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                        To="Transparent"
                        Duration="0:0:0.1"
                    />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
            <!--<Style.Triggers>
                <DataTrigger Binding="{Binding ActiveSession.IsPlaying}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource PauseButton}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActiveSession.IsPlaying}" Value="False">
                    <Setter Property="ContentTemplate" Value="{StaticResource PlayButton}" />
                </DataTrigger>
            </Style.Triggers>-->
        </Style>

        <Style x:Key="MuteToggle" TargetType="ToggleButton">
            <!--<Setter Property="ContentTemplate" Value="{StaticResource UnmuteButton}"/>-->
            <Setter Property="Width" Value="42" />

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            <!--<Setter Property="Foreground" Value="Red"/>-->
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0, 0" />
            <Setter Property="FontFamily" Value="Webdings" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            CornerRadius="4"
                        >
                            <mdi:MaterialIcon Kind="VolumeHigh" x:Name="Icon" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Kind" Value="VolumeOff"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.Setters>
                        <Setter Property="Background" Value="#22666666" />
                    </Trigger.Setters>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                    From="#dd666666"
                                    To="#dd777777"
                                    Duration="0:0:0.1"
                                />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                    To="Transparent"
                                    Duration="0:0:0.1"
                                />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
            <!--<Setter Property="ContentTemplate"></Setter>-->
            <!--<Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content">
                        <Setter.Value>
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                <mdi:MaterialIconExt Kind="VolumeHigh" Animation="Pulse"/>
                            </TextBlock>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                <mdi:MaterialIconExt Kind="VolumeOff" Animation="Pulse"/>
                            </TextBlock>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>-->
        </Style>
    </Window.Resources>
    <AdornerDecorator>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Session" VerticalContentAlignment="Center" Grid.Row="0" Margin="0 0 0 10" />
                <ComboBox
                    Grid.Row="1"
                    ItemsSource="{Binding Sessions}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    x:Name="SessionSelector"
                    b:HintBehavior.HintText="A"
                    SelectedItem="{Binding SelectedSessionListItem}"
                >
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SessionListItem">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    d:Source="/Images/loading.png"
                                    Source="{Binding Icon}"
                                    Height="16"
                                    Width="16"
                                    Margin="0,0,10,0"
                                    Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"
                                />
                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <i:Interaction.Behaviors>
                        <b:HintBehavior />
                    </i:Interaction.Behaviors>
                </ComboBox>
                <Label Content="Playback" VerticalContentAlignment="Center" Grid.Column="1" Margin="0 0 0 10" />
                <ComboBox
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="7 0 0 0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    DockPanel.Dock="Left"
                    ItemTemplate="{StaticResource DeviceItemTemplate}"
                    ItemsSource="{Binding Playback.Devices}"
                    SelectedItem="{Binding Playback.SelectedDevice}"
                    SelectionChanged="ListBox_SelectionChanged"
                    b:HintBehavior.HintText="S"
                >
                    <i:Interaction.Behaviors>
                        <b:HintBehavior />
                    </i:Interaction.Behaviors>
                </ComboBox>
                <Label
                    Content="Recording"
                    VerticalContentAlignment="Center"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0 0 0 10"
                />
                <ComboBox
                    Margin="7 0 0 0"
                    Grid.Column="2"
                    Grid.Row="1"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    ItemTemplate="{StaticResource DeviceItemTemplate}"
                    b:HintBehavior.HintText="R"
                    ItemsSource="{Binding Recording.Devices}"
                    SelectedItem="{Binding Recording.SelectedDevice}"
                    SelectionChanged="ListBox_SelectionChanged"
                >
                    <i:Interaction.Behaviors>
                        <b:HintBehavior />
                    </i:Interaction.Behaviors>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Margin="0"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid
                        Margin="0"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                    >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Backdrop -->
                        <Rectangle
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Fill="{StaticResource PanelBackgroundBrush}"
                            RadiusX="4"
                            RadiusY="4"
                            VerticalAlignment="Top"
                        />
                        <Image
                            d:Source="/Images/loading.png"
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Margin="0"
                            Source="{Binding ActiveSession.Thumbnail}"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            Visibility="{Binding ActiveSession.Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"
                        />
                        <StackPanel
                            Margin="15, 0, 0, 0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource PanelBackgroundBrush}"
                        >
                            <StackPanel.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <LinearGradientBrush.GradientStops>
                                        <GradientStop Offset=".9" Color="Black" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush.GradientStops>
                                </LinearGradientBrush>
                            </StackPanel.OpacityMask>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                    />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock
                                Text="{Binding ActiveSession.Title}"
                                Visibility="{Binding ActiveSession.Title, Converter={StaticResource NullToVisibilityConverter}}"
                                FontWeight="UltraBold"
                                MinWidth="60"
                                d:Text="Title"
                            />
                            <TextBlock
                                Text="{Binding ActiveSession.ArtistName}"
                                Visibility="{Binding ActiveSession.ArtistName, Converter={StaticResource NullToVisibilityConverter}}"
                                d:Text="Artist"
                            />
                            <TextBlock
                                Text="{Binding ActiveSession.AlbumTitle}"
                                Visibility="{Binding ActiveSession.AlbumTitle, Converter={StaticResource NullToVisibilityConverter}}"
                                d:Text="Album"
                            />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button
                            HorizontalAlignment="Right"
                            Style="{StaticResource MediaButton}"
                            Command="{Binding ActiveSession.Prev}"
                            b:HintBehavior.HintText="B"
                        >
                            <!--<mdi:MaterialIconExt Kind="SkipPrevious"/>-->
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Previous_48_Filled}" />
                        </Button>
                        <ToggleButton
                            Style="{StaticResource PlayPauseMediaButton}"
                            Command="{Binding PlayPause}"
                            b:HintBehavior.HintText="P"
                            x:Name="PlayPauseButton"
                            DataContext="{Binding ActiveSession}"
                            IsChecked="{Binding IsPlaying, Mode=OneWay}"
                       />
                        <Button
                            HorizontalAlignment="Left"
                            Style="{StaticResource MediaButton}"
                            Command="{Binding ActiveSession.Next}"
                            b:HintBehavior.HintText="F"
                        >
                            <!--<mdi:MaterialIconExt Kind="SkipNext"/>-->
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Next_48_Filled}" />
                        </Button>
                    </StackPanel>

                    <DockPanel
                        HorizontalAlignment="Stretch"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Center"
                        Grid.Row="1"
                    >
                        <TextBlock
                            Text="{Binding ActiveSession.Position, Converter={StaticResource TimeSpanToStringConverter}}"
                            Grid.Row="1"
                            d:Text="00:00"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="0 0 10 0"
                        />
                        <TextBlock
                            Text="{Binding ActiveSession.Duration, Converter={StaticResource TimeSpanToStringConverter}}"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            d:Text="3:59"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="10 0 0 0"
                        />
                        <Slider
                            Grid.ColumnSpan="5"
                            Grid.Column="0"
                            ValueChanged="Slider_ValueChanged"
                            IsEnabled="{Binding ActiveSession.CanSeek}"
                            AutoToolTipPlacement="None"
                            Thumb.DragStarted="Slider_DragStarted"
                            Thumb.DragCompleted="Slider_DragCompleted"
                            IsMoveToPointEnabled="true"
                            Maximum="{Binding ActiveSession.Duration, Converter={StaticResource TimeSpanToFloatConverter}}"
                            Value="{Binding ActiveSession.Position, Mode=OneWay, Converter={StaticResource TimeSpanToFloatConverter}}"
                        ></Slider>
                    </DockPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Device"
                            Margin="0 0 16 0"
                            VerticalAlignment="Center"
                        />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Application"
                            Margin="0 0 16 0"
                            VerticalAlignment="Center"
                        />
                        <Slider
                            Grid.Column="1"
                            Width="100"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="5"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsMoveToPointEnabled="true"
                            b:HintBehavior.HintText="S"
                            IsEnabled="{Binding ActiveSession.CanChangeDeviceVolume}"
                            
                            Value="{Binding ActiveSession.DeviceVolume, Converter={StaticResource FloatToPercentageConverter}, Mode=OneWay}"
                        />
                        <ToggleButton
                            Style="{StaticResource MuteToggle}"
                            Margin="10 0 0 0"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            DataContext="{Binding Playback.SelectedDevice}"
                            IsChecked="{Binding IsMuted, Mode=OneWay}"
                            Command="{Binding Mute}"
                            b:HintBehavior.HintText="M"
                        >
                            <!--<mdi:MaterialIconExt Kind="VolumeOff"/>-->
                        </ToggleButton>
                        <Slider
                            Grid.Column="1"
                            Grid.Row="1"
                            Width="100"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="5"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsMoveToPointEnabled="true"
                            b:HintBehavior.HintText="V"
                            IsEnabled="{Binding ActiveSession.CanChangeSessionVolume}"
                            Value="{Binding Path=ActiveSession.SessionVolume, Converter={StaticResource FloatToPercentageConverter}, Mode=OneWay}"
                        />

                        <ToggleButton
                            Style="{StaticResource MuteToggle}"
                            Margin="10 0 0 0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Grid.Row="2"
                            Grid.Column="2"
                            DataContext="{Binding ActiveSession}"
                            IsChecked="{Binding IsMuted, Mode=OneWay}"
                            Command="{Binding Mute}"
                            b:HintBehavior.HintText="X"
                        >
                            <!--<mdi:MaterialIconExt Kind="VolumeOff"/>-->
                        </ToggleButton>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </AdornerDecorator>
</reactiveui:ReactiveWindow>
