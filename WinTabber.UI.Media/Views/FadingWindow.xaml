<Window x:Class="WinTabberUI.Views.FadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WinTabberUI.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinTabberUI.Views"
        x:Name="Root"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        SizeToContent="Manual"
        Topmost="True"
        Background="Transparent"
        Height="450" Width="800">

    <Window.Resources>
        <ScaleTransform x:Key="ScaleTransform" ScaleX="1" ScaleY="1" />
        <Storyboard x:Key="FadeOut" Completed="FadeOutStoryboard_Completed">
            <DoubleAnimation 
                Storyboard.TargetProperty="Height" 
                FillBehavior="Stop"
                
                Storyboard.Target="{Binding Path=., ElementName=Root}" 
                From="{Binding Path=AnimationStartHeight, ElementName=Root}"
                To="{Binding Path=AnimationEndHeight, ElementName=Root}"
                Duration="{Binding Path=AnimationDuration, ElementName=Root}">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation 
                FillBehavior="Stop"
                Storyboard.TargetProperty="Opacity" 
                Storyboard.Target="{Binding Path=., ElementName=Root}"
                From="{Binding Path=OpacityStart, ElementName=Root}"
                To="{Binding Path=OpacityEnd, ElementName=Root}"
                Duration="{Binding Path=AnimationDuration, ElementName=Root}">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!--<DoubleAnimation 
                Storyboard.TargetProperty="Width" 
                FillBehavior="Stop"
                
                Storyboard.Target="{Binding Path=., ElementName=Root}" 
                From="{Binding Path=AnimationStartWidth, ElementName=Root}"
                To="{Binding Path=AnimationEndWidth, ElementName=Root}"
                Duration="{Binding Path=AnimationDuration, ElementName=Root}">
              
            </DoubleAnimation>-->



            <DoubleAnimation 
                Storyboard.TargetProperty="Left" 
                FillBehavior="Stop"
                Storyboard.Target="{Binding Path=., ElementName=Root}" 
                From="{Binding Path=AnimationLeftStart, ElementName=Root}"
                To="{Binding Path=AnimationLeftEnd, ElementName=Root}"
                Duration="{Binding Path=AnimationDuration, ElementName=Root}">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation 
                Storyboard.TargetProperty="Top" 
                FillBehavior="Stop"
                Storyboard.Target="{Binding Path=., ElementName=Root}" 
                From="{Binding Path=AnimationTopStart, ElementName=Root}"
                To="{Binding Path=AnimationTopEnd, ElementName=Root}"
                Duration="{Binding Path=AnimationDuration, ElementName=Root}">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

        </Storyboard>
    </Window.Resources>
    <!--<chrome:AcrylicChrome.AcrylicChrome>
        <chrome:AcrylicChrome AccentState="ACCENT_ENABLE_BLURBEHIND" CornerPreference="DWMWCP_ROUND" UnderStratumColor="#55ff0000" />
    </chrome:AcrylicChrome.AcrylicChrome>-->
    <Viewbox x:Name="IMG" HorizontalAlignment="Stretch" Stretch="Fill" >
        <Image Source="{Binding}">

        </Image>
    </Viewbox>
</Window>
